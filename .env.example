# ─── Google Gemini (required in non-mock mode) ───────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Model (defaults to gemini-3.8-flash if not set) ─────────────────────────
GEMINI_MODEL=gemini-3.8-flash

# ─── Mock Mode (set to true to run without a real API key) ───────────────────
# When MOCK_MODE=true, the app returns the realistic internship demo response.
MOCK_MODE=false

# ─── GCP / Secret Manager (optional — only needed for Cloud Run deployment) ──
# When both are set, the API key is loaded from Secret Manager instead of env.
GCP_PROJECT=your-gcp-project-id
SECRET_NAME=gemini-api-key

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_RPM=20

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Cache ───────────────────────────────────────────────────────────────────
CACHE_MAX_SIZE=128
